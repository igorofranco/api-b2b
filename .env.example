# .env.example — copie para .env e preencha. NUNCA commite o .env real.

# Aplicação
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=apib2b
POSTGRES_PASSWORD=apib2b
POSTGRES_DB=apib2b
DATABASE_URL=postgresql://apib2b:apib2b@localhost:5432/apib2b?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth (troque por um segredo forte em produção)
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# Idempotência (TTL em segundos da resposta guardada)
IDEMPOTENCY_TTL_SECONDS=86400
